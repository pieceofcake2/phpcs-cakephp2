<?xml version="1.0"?>
<ruleset name="CakePHP2Namespace">
    <description>The CakePHP2 standard for CakePHP 2 applications and plugins whose classes are in namespaces</description>

    <!-- Everything that is not about namespaces is the CakePHP2 standard -->
    <rule ref="CakePHP2">
        <!-- Replaced by CakePHP2Namespace.Commenting.TypeHint (see Sniffs/Commenting/TypeHintSniff.php):
             when phpcbf imports a class name of an annotation, this sniff parses the doc comment in the
             middle of the change and stops phpcbf with a fatal error. -->
        <exclude name="CakePHP.Commenting.TypeHint"/>
    </rule>

    <!-- The order of the types in @param, @return and @var, as CakePHP.Commenting.TypeHint checks it.
         Like that sniff, it does not check the tests. -->
    <rule ref="CakePHP2Namespace.Commenting.TypeHint">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- The rules below turn sniffs back on that CakePHP2 excludes for global classes. A message that
         a referenced standard excludes only comes back with an explicit severity. -->

    <!-- ===== Namespace and Class Rules ===== -->
    <!-- Classes are declared in a namespace. The configuration files keep their global classes
         (DATABASE_CONFIG in config/database.php, the schema classes in config/Schema/). -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <severity>5</severity>
        <exclude-pattern>*/config/*</exclude-pattern>
    </rule>
    <!-- Composer loads the classes, so a class file needs no App::uses() -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <severity>5</severity>
    </rule>
    <!-- PSR-4 finds a class only in the file named after it. The configuration files keep their names,
         and test files may declare test doubles next to the test case. -->
    <rule ref="Squiz.Classes.ClassFileName.NoMatch">
        <severity>5</severity>
        <exclude-pattern>*/config/*</exclude-pattern>
        <exclude-pattern>*/tests/TestCase/*</exclude-pattern>
        <exclude-pattern>*/Test/Case/*</exclude-pattern>
    </rule>

    <!-- ===== Namespace/Import Rules ===== -->
    <!-- ReferenceUsedNamesOnly.ReferenceViaFullyQualifiedNameWithoutNamespace stays excluded as in CakePHP2:
         in the files without a namespace (configuration, templates), phpcbf would turn #[\AllowDynamicProperties]
         into [AllowDynamicProperties], which does not parse. -->
    <!-- Annotations name classes like the code does: imported with use and written by their short names
         (@param Model $Model, not @param \Cake\Model\Model $Model). This includes global classes
         (use Exception; and @throws Exception). FullyQualifiedClassNameInAnnotation stays excluded. -->
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly">
        <properties>
            <property name="searchAnnotations" type="boolean" value="true"/>
        </properties>
    </rule>
    <!-- A use statement for a class that only annotations name is not unused -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" type="boolean" value="true"/>
        </properties>
    </rule>
</ruleset>
