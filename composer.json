{
    "name": "pieceofcake2/phpcs-cakephp2",
    "description": "PHP_CodeSniffer ruleset for CakePHP 2 applications and plugins, based on the CakePHP coding standard",
    "type": "phpcodesniffer-standard",
    "keywords": ["phpcs", "codesniffer", "coding standard", "cakephp", "cakephp2"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "cakephp/cakephp-codesniffer": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "PieceOfCake2\\PhpcsCakePHP2\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "phpunit": "phpunit",
        "test": [
            "@phpunit",
            "@cs-check"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
